# Emerald Group — variáveis de ambiente
#
# Este site é publicado como frontend estático (vite build → dist/public).
# Não precisa de backend, base de dados ou autenticação para funcionar.

# Analytics (opcional). Deixar vazio para não carregar nenhum script de analytics.
# Se ativar um serviço (Umami, Plausible, GA, etc.), adicionar o script correspondente
# em client/index.html e preencher as variáveis que esse serviço pedir.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Formulário de contacto (client/src/components/ContactSection.tsx).
# Atualmente tenta enviar via tRPC para /api/trpc/contact.submit, que não existe
# no deploy estático — a submeter, o visitante vê um erro. A configurar quando o
# site for aprovado (ver TODO em server/routers.ts e discussão sobre serviço de
# envio de formulário, ex: Web3Forms/Formspree).
# CONTACT_FORM_ENDPOINT=
# CONTACT_FORM_API_KEY=
