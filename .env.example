# Emerald Group — variáveis de ambiente
#
# O site é um único servidor Node/Express: serve o frontend (client/) e expõe
# uma mini API em POST /api/contact que envia o formulário de contacto por
# email via SMTP (Nodemailer). Pensado para correr como App Service no Azure.

PORT=3000

# Analytics (opcional). Deixar vazio para não carregar nenhum script de analytics.
# Se ativar um serviço (Umami, Plausible, GA, etc.), adicionar o script correspondente
# em client/index.html e preencher as variáveis que esse serviço pedir.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# SMTP para o formulário de contacto (server/mailer.ts).
# Funciona com qualquer fornecedor SMTP — Microsoft 365, Gmail/Google Workspace, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Emerald Group Website <no-reply@emeraldgroup-inc.com>"

# Para onde é enviada cada submissão do formulário de contacto.
CONTACT_TO_EMAIL=info@emeraldgroup-inc.com
